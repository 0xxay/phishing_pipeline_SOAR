# OpenAI Configuration
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# Gmail Configuration
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.pickle
GMAIL_LABEL=phishing
GMAIL_MAX_RESULTS=10

# Enrichment API Keys
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=

# TheHive Configuration
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=

# Slack Configuration
SLACK_WEBHOOK_URL=

# Pipeline Configuration
POLL_INTERVAL=300
MAX_RETRIES=3
RETRY_DELAY=2

# Scoring Thresholds
VT_DETECTION_THRESHOLD=5
ABUSEIPDB_CONFIDENCE_THRESHOLD=70
GPT_MALICIOUS_THRESHOLD=0.8
GPT_SUSPICIOUS_THRESHOLD=0.5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=phishing_pipeline.log

# Block List Configuration
BLOCK_LIST_FILE=block_list.json

# Feature Flags
SKIP_GMAIL=false
SKIP_THEHIVE=false
SKIP_SLACK=false
DRY_RUN=false
